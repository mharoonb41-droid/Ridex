<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <!-- Google Map -->
    <fragment
        android:id="@+id/riderMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#CC0F0F0F"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=" RideX"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFD700"/>

        <Button
            android:id="@+id/logoutBtn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Logout"
            android:textSize="12sp"
            android:textColor="#FFD700"
            android:backgroundTint="#1F1F1F"/>

    </LinearLayout>

    <!-- Bottom Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#EE0F0F0F"
        android:padding="24dp">

        <!-- Destination Input -->
        <EditText
            android:id="@+id/destinationInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint=" Where do you want to go?"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/input_background"/>

        <!-- Check Price Button -->
        <Button
            android:id="@+id/checkPriceBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="CHECK PRICE!"
            android:textSize="14sp"
            android:textColor="#FFD700"
            android:backgroundTint="#1F1F1F"
            android:layout_marginBottom="8dp"/>

        <!-- Price Info Card -->
        <LinearLayout
            android:id="@+id/priceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/input_background"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <!-- Distance -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distance"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/distanceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- km"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- Duration -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/durationText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- min"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- Price -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price:"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/priceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- Rs"
                    android:textColor="#FFD700"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Ride Status -->
        <TextView
            android:id="@+id/rideStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready to ride! "
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <!-- Request Ride Button -->
        <Button
            android:id="@+id/requestRideBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="REQUEST RIDEX "
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#0F0F0F"
            android:backgroundTint="#FFD700"/>

    </LinearLayout>

</RelativeLayout>